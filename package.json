{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "vue-template",
    "version": "0.1.0",
    "private": true,
    "description": "A template with Nuxt 4 built on Vue 3 with focus on performance and best practices.",
    "keywords": [
        "template"
    ],
    "homepage": "https://github.com/krudi/vue-template#readme",
    "bugs": {
        "url": "https://github.com/krudi/vue-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/vue-template.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "scripts": {
        "auth:generate": "auth generate --config server/auth/auth.ts --adapter drizzle --dialect postgresql --output server/db/schemas/auth.ts",
        "auth:info": "auth info --config server/auth/auth.ts",
        "auth:secret": "auth secret",
        "build": "nuxt build",
        "clean": "rm -rf .cache node_modules .nuxt .output",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "nuxt task run db:seed",
        "dev": "nuxt dev",
        "format:ox": "oxfmt .",
        "format:ox:check": "oxfmt --check .",
        "generate": "nuxt generate",
        "install:lefthook": "lefthook install",
        "knip": "knip",
        "lint": "npm run lint:ox && npm run format:ox:check",
        "lint:ox": "oxlint .",
        "lint:ox:fix": "oxlint . --fix",
        "prepare:nuxt": "nuxt prepare",
        "preview": "nuxt preview",
        "start": "node --env-file-if-exists=.env .output/server/index.mjs",
        "typecheck": "nuxt typecheck",
        "verify:static": "npm run typecheck && npm run lint && npm run knip"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">= 24.19.0",
        "npm": ">= 12.0.0"
    },
    "overrides": {
        "nanoid": "^3.3.18"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@iconify-json/lucide": "^1.2.140",
        "@nuxt/hints": "^1.1.4",
        "@nuxt/image": "^2.1.0",
        "@nuxt/ui": "^4.11.3",
        "@nuxtjs/robots": "^6.2.4",
        "@nuxtjs/sitemap": "^8.6.1",
        "@t3-oss/env-nuxt": "^0.13.11",
        "better-auth": "^1.7.7",
        "drizzle-orm": "^0.45.3",
        "nodemailer": "^10.0.10",
        "nuxt": "^4.6.0",
        "postgres": "^3.4.9",
        "qrcode.vue": "^3.11.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^24.19.1",
        "@types/nodemailer": "^8.0.2",
        "auth": "^1.7.7",
        "drizzle-kit": "^0.31.11",
        "knip": "^6.40.0",
        "lefthook": "^2.1.17",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "typescript": "^6.0.2",
        "vue-tsc": "^3.3.12"
    }
}
