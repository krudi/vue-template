{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "vue-template",
    "version": "0.1.0",
    "private": false,
    "description": "A template with Nuxt3 built on Vue3 with focus on performance and best practices.",
    "keywords": [
        "template"
    ],
    "homepage": "https://github.com/krudi/vue-template#readme",
    "bugs": {
        "url": "https://github.com/krudi/vue-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/vue-template.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "clean": "rm -rf .cache node_modules .nuxt .output",
        "dev": "nuxt dev",
        "format:ox": "oxfmt .",
        "format:ox:check": "oxfmt --check .",
        "generate": "nuxt generate",
        "lint": "npm run lint:ox && npm run format:ox:check",
        "lint:ox": "oxlint .",
        "lint:ox:fix": "oxlint . --fix",
        "preview": "nuxt preview",
        "start": "node .output/server/index.mjs",
        "typecheck": "nuxt typecheck"
    },
    "devDependencies": {
        "@krudi/typescript-config": "^0.1.9",
        "@nuxt/devtools": "^3.4.1",
        "@types/node": "^24.13.3",
        "autoprefixer": "^10.5.4",
        "nuxt": "^4.5.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "postcss": "^8.5.25",
        "postcss-import": "^16.1.1",
        "postcss-load-config": "^6.0.1",
        "postcss-nesting": "^14.0.1",
        "typescript": "^6.0.2",
        "vue-tsc": "^3.3.9"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">= 24.19.0",
        "npm": ">= 12.0.0"
    }
}
