{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "vue-template",
    "version": "0.1.0",
    "private": true,
    "description": "A template with Nuxt 4 built on Vue 3 with focus on performance and best practices.",
    "keywords": [
        "template"
    ],
    "homepage": "https://github.com/krudi/vue-template#readme",
    "bugs": {
        "url": "https://github.com/krudi/vue-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/vue-template.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "clean": "rm -rf .cache node_modules .nuxt .output",
        "dev": "nuxt dev",
        "format:ox": "oxfmt .",
        "format:ox:check": "oxfmt --check .",
        "generate": "nuxt generate",
        "install:lefthook": "lefthook install",
        "knip": "knip",
        "lint": "npm run lint:ox && npm run format:ox:check",
        "lint:ox": "oxlint .",
        "lint:ox:fix": "oxlint . --fix",
        "prepare:nuxt": "nuxt prepare",
        "preview": "nuxt preview",
        "start": "node .output/server/index.mjs",
        "typecheck": "nuxt typecheck",
        "verify:static": "npm run typecheck && npm run lint && npm run knip"
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">= 24.19.0",
        "npm": ">= 12.0.0"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@lucide/vue": "^1.52.0",
        "@nuxtjs/color-mode": "^4.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "nuxt": "^4.6.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@types/node": "^24.19.1",
        "knip": "^6.40.0",
        "lefthook": "^2.1.17",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "shadcn-vue": "^2.8.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.2",
        "vue-tsc": "^3.3.12"
    }
}
